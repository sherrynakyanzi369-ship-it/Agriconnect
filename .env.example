# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/farm_marketplace

# Session
SESSION_SECRET=change_this_to_a_long_random_string

# File uploads
MAX_FILE_SIZE_MB=5

# Seed script (optional): creates an admin account when running `npm run seed`
ADMIN_NAME=Site Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
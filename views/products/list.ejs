<%
  const safeLocations = typeof locations !== 'undefined' && locations ? locations : [];
  const safeQuery = typeof query !== 'undefined' ? query : {};
%>
<section class="section-head">
  <h1>Browse Produce</h1>
  <span class="results-count"><%= products.length %> product<%= products.length === 1 ? '' : 's' %></span>
</section>

<form class="filters reveal" action="/products" method="GET">
  <input type="search" name="q" placeholder="Search products..." value="<%= safeQuery.q || '' %>" />
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach((c) => { %>
      <option value="<%= c.slug %>" <%= safeQuery.category === c.slug ? 'selected' : '' %>><%= c.name %></option>
    <% }) %>
  </select>
  <select name="farm">
    <option value="">All farms</option>
    <% farms.forEach((f) => { %>
      <option value="<%= f._id %>" <%= safeQuery.farm && String(safeQuery.farm) === String(f._id) ? 'selected' : '' %>><%= f.name %></option>
    <% }) %>
  </select>
  <select name="location">
    <option value="">All locations</option>
    <% safeLocations.forEach((loc) => { %>
      <option value="<%= loc %>" <%= safeQuery.location === loc ? 'selected' : '' %>><%= loc %></option>
    <% }) %>
  </select>
  <input type="number" name="min" placeholder="Min price" value="<%= safeQuery.min || '' %>" step="0.01" />
  <input type="number" name="max" placeholder="Max price" value="<%= safeQuery.max || '' %>" step="0.01" />
  <button class="btn btn-primary" type="submit">Filter</button>
</form>

<% if (products.length) { %>
  <div class="grid">
    <% products.forEach((p) => { %>
      <% const outOfStock = p.status === 'OUT_OF_STOCK' || p.quantityAvailable < 1; %>
      <% const lowStock = !outOfStock && p.quantityAvailable <= 5; %>
      <div class="card reveal <%= outOfStock ? 'is-out' : '' %>">
        <span class="thumb">
          <img src="<%= h.imageUrl(p.image) %>" alt="<%= p.name %>" loading="lazy" />
          <span class="card-ribbons">
            <% if (outOfStock) { %><span class="badge badge-out">Out of stock</span><% } else if (lowStock) { %><span class="badge badge-low">Low stock</span><% } %>
          </span>
          <% if (user && !outOfStock) { %>
            <button type="button" class="quick-add" data-product="<%= p._id %>" aria-label="Add <%= p.name %> to cart">+ Add</button>
          <% } %>
        </span>
        <div class="card-body">
          <% if (p.category) { %><span class="card-cat"><%= p.category.name %></span><% } %>
          <h3><%= p.name %></h3>
          <p class="muted"><%= p.profile ? p.profile.farmName : (p.farmer ? p.farmer.name : 'Local Farm') %></p>
          <div class="card-meta">
            <span class="price"><%= h.currency(p.price) %><small> / <%= p.unit %></small></span>
            <% if (!outOfStock) { %><span class="card-stock <%= lowStock ? 'is-low' : '' %>"><%= p.quantityAvailable %> in stock</span><% } %>
          </div>
          <a class="stretched-link" href="/products/<%= p._id %>" aria-label="<%= p.name %>"></a>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty">
    <span class="empty-icon">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
    </span>
    <p>No products match your search.</p>
    <p class="muted">Try adjusting your filters or <a href="/products">view everything</a>.</p>
  </div>
<% } %>
<section class="auth-card">
  <h1><%= product ? 'Edit Product' : 'Add Product' %></h1>
  <form action="/products<%= product ? '/' + product._id + '?_method=PUT' : '' %>" method="POST" enctype="multipart/form-data">
    <div class="float-field">
      <input type="text" name="name" id="name" value="<%= product ? product.name : '' %>" placeholder=" " required />
      <label for="name">Product Name</label>
    </div>

    <div class="float-field">
      <textarea name="description" id="description" rows="4" placeholder=" "><%= product ? product.description : '' %></textarea>
      <label for="description">Description</label>
    </div>

    <div class="form-row">
      <div>
        <label for="category">Category</label>
        <select name="category" id="category" required>
          <% categories.forEach((c) => { %>
            <option value="<%= c._id %>" <%= product && String(product.category) === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="float-field">
        <input type="number" name="price" id="price" min="0" step="0.01"
          value="<%= product ? product.price : '' %>" placeholder=" " required />
        <label for="price">Price</label>
      </div>
      <div>
        <label for="unit">Unit</label>
        <select name="unit" id="unit" required>
          <% ['kg', 'lb', 'crate', 'bunch', 'each', 'dozen', 'bag', 'bushel'].forEach((u) => { %>
            <option value="<%= u %>" <%= product && product.unit === u ? 'selected' : '' %>><%= u %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="float-field">
      <input type="number" name="quantityAvailable" id="quantityAvailable" min="0"
        value="<%= product ? product.quantityAvailable : '' %>" placeholder=" " />
      <label for="quantityAvailable">Quantity Available</label>
    </div>
    <p class="muted">Availability status updates automatically (0 or less = out of stock).</p>

    <div class="float-field">
      <input type="date" name="harvestDate" id="harvestDate"
        value="<%= product && product.harvestDate ? product.harvestDate.toISOString().slice(0, 10) : '' %>" placeholder=" " />
      <label for="harvestDate">Harvest Date</label>
    </div>

    <label for="image">Photo</label>
    <div class="file-field">
      <input type="file" name="image" id="image" accept="image/*" data-preview="<%= product && product.image ? h.imageUrl(product.image) : '' %>" />
      <img class="file-preview <%= product && product.image ? 'has-img' : '' %>" id="image-preview" src="<%= product && product.image ? h.imageUrl(product.image) : '' %>" alt="Preview" />
    </div>

    <button class="btn btn-primary btn-block" type="submit">
      <%= product ? 'Save Changes' : 'List Product' %>
    </button>
  </form>
</section>
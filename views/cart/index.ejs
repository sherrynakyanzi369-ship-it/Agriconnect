<section class="section-head">
  <h1>Your Cart</h1>
  <span class="results-count"><%= lines.reduce((n, l) => n + l.quantity, 0) || 0 %> item<%= lines.reduce((n, l) => n + l.quantity, 0) === 1 ? '' : 's' %></span>
</section>

<% if (empty) { %>
  <div class="empty">
    <span class="empty-icon">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    </span>
    <p>Your cart is empty.</p>
    <p class="muted"><a href="/products">Browse produce</a> to find fresh goods from local farms.</p>
  </div>
<% } else { %>
  <div class="cart-layout" id="cart-page">
    <div class="cart-items">
      <div class="table-wrap">
        <table class="cart-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="cart-rows">
            <% lines.forEach((line) => { %>
              <tr class="cart-row" data-product="<%= line.productId %>">
                <td>
                  <a href="/products/<%= line.productId %>" class="cart-name">
                    <span class="cart-thumb"><img src="<%= h.imageUrl(line.image) %>" alt="" /></span>
                    <span><%= line.name %></span>
                  </a>
                  <% if (line.outOfStock) { %><br /><span class="badge badge-low">Low stock</span><% } %>
                </td>
                <td><%= h.currency(line.price) %> / <%= line.unit %></td>
                <td class="cart-qty">
                  <input
                    type="number"
                    value="<%= line.quantity %>"
                    min="1"
                    max="<%= line.available || line.quantity %>"
                    data-product="<%= line.productId %>"
                    <%= line.outOfStock ? 'disabled' : '' %>
                  />
                </td>
                <td class="cart-line-total" data-field="lineTotal"><%= h.currency(line.totalPrice) %></td>
                <td>
                  <form action="/cart/remove/<%= line.productId %>" method="POST" class="inline">
                    <input type="hidden" name="_format" value="form" />
                    <button class="btn btn-danger btn-sm cart-remove" type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted cart-feedback" id="cart-feedback"></p>
    </div>

    <aside class="cart-summary">
      <h3>Order Summary</h3>
      <div class="line"><span>Subtotal</span><span id="subtotal"><%= h.currency(cart.totalPrice) %></span></div>
      <hr />
      <div class="line"><span>Total</span></div>
      <p class="cart-total" id="cart-total"><%= h.currency(cart.totalPrice) %></p>
      <a class="btn btn-primary btn-block" href="/cart/checkout">Proceed to Checkout</a>
      <a class="btn btn-outline btn-block" href="/products">Continue Shopping</a>
    </aside>
  </div>
<% } %>

<script src="/js/cart.js" defer></script>
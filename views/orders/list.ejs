<section class="section-head">
  <h1>My Orders</h1>
</section>

<% if (orders.length) { %>
  <div class="grid">
    <% orders.forEach((o) => { %>
      <a class="card" href="/orders/<%= o._id %>">
        <div class="card-body">
          <h3>Order #<%= o._id.toString().slice(-8) %></h3>
          <p class="muted"><%= new Date(o.createdAt).toLocaleDateString() %> &middot; <%= o.items.reduce((n, i) => n + i.quantity, 0) %> item(s)</p>
          <div class="card-meta">
            <span class="price price-lg"><%= h.currency(o.totalPrice) %></span>
            <span class="badge badge-<%= o.status.toLowerCase() %>"><%= o.status %></span>
          </div>
        </div>
      </a>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty">
    <span class="empty-icon">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 7h10v10H7z"/><path d="M10 10h4v4h-4z"/></svg>
    </span>
    <p>You haven't placed any orders yet.</p>
    <p class="muted"><a href="/products">Browse produce</a> to get started.</p>
  </div>
<% } %>
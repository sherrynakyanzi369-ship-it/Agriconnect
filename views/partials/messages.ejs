<% if (success_msg && success_msg.length) { %>
  <div class="flash flash-success" role="status">
    <span><%= success_msg[0] %></span>
    <button class="flash-close" type="button" aria-label="Dismiss">×</button>
  </div>
<% } %>
<% if (error_msg && error_msg.length) { %>
  <div class="flash flash-error" role="alert">
    <span><%= error_msg[0] %></span>
    <button class="flash-close" type="button" aria-label="Dismiss">×</button>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length) { %>
  <div class="flash flash-error" role="alert">
    <span><%= error[0] %></span>
    <button class="flash-close" type="button" aria-label="Dismiss">×</button>
  </div>
<% } %>
<header class="navbar">
  <div class="container navbar-inner">
    <a class="brand" href="/">
      <span class="brand-mark">
        <svg class="brand-leaf" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
      </span>
      AgriConnect
    </a>
    <nav>
      <a href="/products">Browse Produce</a>
      <% if (user) { %>
        <% const cartCountSafe = typeof cartCount !== 'undefined' ? cartCount : 0; %>
        <a class="nav-cart" href="/cart">Cart <% if (cartCountSafe > 0) { %><span class="cart-count"><%= cartCountSafe %></span><% } %></a>
        <% if (user.role === 'FARMER') { %>
          <a href="/farm/dashboard">Dashboard</a>
          <a href="/products/new">Add Product</a>
        <% } %>
        <details class="user-menu">
          <summary class="user-btn" aria-label="Account menu">
            <span class="avatar"><%= (user.name || 'U').charAt(0).toUpperCase() %></span>
            <span class="user-name"><%= (user.name || 'User').split(' ')[0] %></span>
          </summary>
          <div class="menu-panel">
            <div class="menu-head">
              <strong><%= user.name %></strong>
              <span class="muted"><%= user.email %></span>
            </div>
            <a href="/orders">My Orders</a>
            <% if (user.role === 'FARMER') { %>
              <a href="/farm/dashboard">Farmer Dashboard</a>
              <a href="/products/new">Add Product</a>
            <% } %>
            <a class="logout-link" href="/auth/logout">Logout</a>
          </div>
        </details>
      <% } else { %>
        <a href="/auth/login">Log In</a>
        <a href="/auth/register" class="btn btn-primary">Sign Up</a>
      <% } %>
    </nav>
  </div>
</header>